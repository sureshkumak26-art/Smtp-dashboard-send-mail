PORT=3000
SESSION_SECRET=change-this-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mail@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM="My Company <mail@example.com>"
# Optional: public HTTPS logo URL for HTML emails
MAIL_LOGO_URL=https://your-domain.com/logo.png
# Or place logo.png at public/logo.png on the server for CID embedding
MAIL_LOGO_PATH=public/logo.png
MAX_RECIPIENTS=25
SEND_DELAY_MS=1000
